# ---- Unity generated ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ship debug info
[Bb]urstDebugInformation_DoNotShip/
*_BurstDebugInformation_DoNotShip/

# Asset meta backups
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Autogenerated IDE/solution files (regenerated by Unity on open)
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Crashlytics / diagnostics
crashlytics-build.properties
sysinfo.txt

# Local WebGL/Windows build output dropped straight in the project root
# during iteration (these are copied to disasterready/public/unity-sim
# for the web app to serve, and to a separate Windows build folder — the
# raw build output itself is not versioned).
WebGLBuild_raw*/
WindowsBuild*/

# Builder/Package cache
[Pp]ackages/*.meta
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# OS / editor cruft
.DS_Store
Thumbs.db

# Secrets (should never exist here, but guard anyway)
*.env
*.env.local
